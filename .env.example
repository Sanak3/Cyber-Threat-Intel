# --- NIST API Configuration ---
# Obtenha sua chave gratuita em: https://nvd.nist.gov/developers/request-an-api-key
NIST_API_KEY=sua_chave_nist_aqui

# --- Database Configuration (AWS RDS / PostgreSQL) ---
DB_HOST=seu-endpoint-rds.amazonaws.com
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua_senha_do_banco
DB_PORT=5432

# --- Backend API Configuration ---
PORT=5001

# --- Frontend Configuration (Opcional se rodar localmente na porta 5001) ---
VITE_API_URL=http://localhost:5001
