# ==============================================================================
# Cyber Threat Intel Pipeline - Variáveis de Ambiente
# ==============================================================================

# --- NIST API Configuration ---
# Obtenha sua chave gratuita em: https://nvd.nist.gov/developers/request-an-api-key
NIST_API_KEY=sua_chave_nist_aqui

# --- Database Configuration (AWS RDS / PostgreSQL) ---
DB_HOST=seu-endpoint-rds.amazonaws.com
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua_senha_do_banco
DB_PORT=5432
DB_SSL=true
# Mantenha false caso nao defina DB_SSL_CA com o bundle PEM da AWS RDS (evita SELF_SIGNED_CERT_IN_CHAIN no Render)
DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...

# --- Backend API & Webhook Configuration ---
PORT=5001
FRONTEND_URL=https://cyber-threat-intel-three.vercel.app
API_URL=http://localhost:5001
INTERNAL_WEBHOOK_SECRET=gere_um_segredo_aleatorio_forte_aqui

# --- Frontend Configuration (Opcional se rodar localmente na porta 5001) ---
VITE_API_URL=http://localhost:5001
